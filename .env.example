# GEMINI_API_KEY: Server-side Gemini API key for Google Maps Grounding and Live Voice scheduling helper.
# Never expose this key in client-side VITE_* variables or commit real keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser API key (Places API New + Maps JS API).
# Do not commit real API keys; restrict keys by HTTP referrer in production.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# OPENAI_API_KEY: Optional server-side key for the Patient Appointment Assistant LLM navigation.
# Never expose this key in client-side VITE_* variables or commit real keys.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# SESSION_SECRET: Random secret used to sign HTTP-only staff authentication cookies.
# Leave unset in local dev to generate an ephemeral secret, or set a strong string in production.
SESSION_SECRET="REPLACE_WITH_RANDOM_32_CHAR_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
